# Tashkhees — environment variables
# Copy to .env and fill in. Every value below has a safe development default,
# so the app runs with no .env at all. Production enforces the ones marked.

# --- Core -------------------------------------------------------------------
# "development" or "production". In production the app refuses to start with a
# default or short SECRET_KEY, or with DEBUG=true.
ENVIRONMENT=development
DEBUG=false

# --- Security ---------------------------------------------------------------
# REQUIRED IN PRODUCTION. Signs every JWT. Must be >= 32 characters there.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me

# Access-token lifetime in minutes. Default 1440 (24 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---------------------------------------------------------------
# SQLite for development. For production use PostgreSQL, e.g.
#   postgresql+psycopg2://tashkhees:tashkhees@db:5432/tashkhees
# On serverless platforms a SQLite URL is redirected to /tmp automatically.
DATABASE_URL=sqlite:///./tashkhees.db

# --- Uploads ----------------------------------------------------------------
# Where uploaded radiographs are stored. Redirected to /tmp on serverless.
UPLOAD_DIR=./uploads
# Hard ceiling on an uploaded file, in bytes. Default 12 MB.
MAX_UPLOAD_BYTES=12582912
# Reject images whose shorter side is below this, in pixels. Default 256.
MIN_IMAGE_SIDE=256

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:8012,http://127.0.0.1:8012

# --- Rate limits ------------------------------------------------------------
# Format: "<count>/<second|minute|hour>". Applied per client IP, per path.
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_ANALYSIS=20/minute
RATE_LIMIT_DEFAULT=120/minute
